.DS_Store
__pycache__/
*.pyc
node_modules/
# 取得した元データ（再配布しない入力。生成物だけを kuniezu/static/kuniezu/ に置く）
.cache/
# 地図の配信物（正本 kuniezu/map と差分の入力 kuniezu/map/edits/*.json から node tools/map/build-map.cjs で kuniezu/static/kuniezu/map/build に生成。コミットしない）
/kuniezu/static/kuniezu/map/build/
# 実画面の画像・動画・JSONログ（結果の要約 README.md だけをコミットし、画像は PR に添付する。既に追跡中のものは履歴として残る）
/data/verification/**/*.json
/data/verification/**/*.png
/data/verification/**/*.jpg
/data/verification/**/*.jpeg
/data/verification/**/*.webp
/data/verification/**/*.gif
/data/verification/**/*.webm
/data/verification/**/*.mp4

# 検証の比較ページ（画像を埋め込むので Git に入れない）
data/verification/**/*.html

# Django・uv の骨組み（docs/architecture/replatform-plan.md 段 1）
.venv/
/dist/
/staticfiles/
/db.sqlite3
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Local battle DEM build workspace; served relief and source provenance are tracked.
/data/inputs/nagakute-dem/build/

# Wrangler のローカルの状態
/.wrangler/
