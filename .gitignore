.DS_Store
__pycache__/
*.pyc
node_modules/
# 取得した元データ（再配布しない入力。生成物だけを game/ に置く）
.cache/
# 地図の配信物（正本 game/map と差分の入力 game/map/edits/*.json から node tools/map/build-map.cjs で game/map/build に生成。コミットしない）
/game/map/build/
# 実画面の証拠の画像・動画（結果の要約 README.md だけをコミットし、画像は PR に添付する。既に追跡中のものは履歴として残る）
/data/verification/**/*.png
/data/verification/**/*.jpg
/data/verification/**/*.jpeg
/data/verification/**/*.webp
/data/verification/**/*.gif
/data/verification/**/*.webm
/data/verification/**/*.mp4

# 検証の比較ページ（画像を埋め込むので Git に入れない）
data/verification/**/*.html

# Django・uv の骨組み（docs/architecture/replatform-plan.md 段 1）
.venv/
/dist/
/staticfiles/
/db.sqlite3
.ruff_cache/
.mypy_cache/
.pytest_cache/
