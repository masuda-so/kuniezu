  "adoptionDecision": {
    "accepted": [
      "内浪逆浦を昭和造成後の一枚の陸として扱う根拠は不適切と判定する。",
      "迅速図の湖内確認点・水域と外浪逆浦の接続は1885年の位置付き証拠として採用。",
      "1560〜1615の描画を改める場合、現代標高3m閾値を復元根拠から外し、古い入江を示す推定水域として扱う方針は採用可能。"
    ],
    "rejected": [
      "1885年の岸を1560年の測量岸として直接コピー。",
      "現代の日の出地区196ha全域を一律に水面へ反転。",
      "1931〜1950年の堤防、1970年代の排水路・盛土面・宅地区画を戦国期に表示。",
      "1590年・1603年の一括地形切替、年代不明の中間汀線補間。"
    ],
    "notEstablished": [
      "1560年の精密な外縁、季節水位、葦原と恒常水面の境界。",
      "1654年以前から1885年まで変わらない岸区間。",
      "南東の自然堤防・耕地の形を特定の戦国年へ固定すること。"
    ],
    "nextDecisiveEvidence": [
      "正保期の延方前洲・徳島地を描いた提出絵図の所在と原図（地域の境界争論史料に言及）。既知の延方・潮来・下幡木を同定し、内浪逆浦北岸と南東洲を別に登録する。",
      "天正〜慶長の津知・延方・大洲の検地帳／村田氏系図と、その所在地がわかる考古・字限図。家数や開拓開始年を岸線そのものに読み替えない。",
      "日の出70m地質コアの上部自然層について年代測定と旧水面・汽水指標。現代造成層を差し引いた標高だけで1560年の水位を決めない。"
    ],
    "rasterPatchReady": false,
    "reason": "近現代造成の誤採用を退ける判断は終了。16世紀の精密外縁が未確定なので、虚偽の確定岸を量産せず位置付き参考水域として提案する。"
  },
